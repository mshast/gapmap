# Offline, fixture-scoped demo. Set to 0 for real extraction.
GAPMAP_DEMO_MODE=1
# Server-side only. Required for live extraction; do not commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq instead of OpenAI: set GAPMAP_LLM_PROVIDER=groq. Analysis and interviews both use it.
# GAPMAP_LLM_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
# gpt-oss defaults to low reasoning (about half the tokens of medium, same extraction
# quality in testing). Groq's free tier allows 8,000 tokens per minute, roughly three
# analyses; short rate limits are waited out automatically.
# GROQ_REASONING_EFFORT=low
